      "unit_id": "PRE_A1-U08",
      "order": 8,
      "title_zh": "我的一天与综合生存对话",
      "title_en": "My Day and Survival Check",
      "prerequisite_units": ["PRE_A1-U07"],
      "prerequisite_knowledge_ids": ["PRE_A1-K013", "PRE_A1-K021", "PRE_A1-K025"],
      "knowledge": [
        {"knowledge_id": "PRE_A1-K029", "type": "vocabulary", "form": "get up / eat / go / work / study / sleep", "meaning_zh": "基础日常动作"},
        {"knowledge_id": "PRE_A1-K030", "type": "grammar", "form": "I + base verb.", "meaning_zh": "用最短句说日常动作"},
        {"knowledge_id": "PRE_A1-K031", "type": "chunk", "form": "every day / in the morning / at night", "meaning_zh": "基础时间表达"},
        {"knowledge_id": "PRE_A1-K032", "type": "interaction", "form": "greet → answer → ask for help → close", "meaning_zh": "四步生存对话结构"}
      ],
      "objectives": [
        {"objective_id": "PRE_A1-O015", "mode": "speaking", "can_do_zh": "不用句首提示，说出两个真实日常动作。", "target_knowledge_ids": ["PRE_A1-K029", "PRE_A1-K030", "PRE_A1-K031"], "evidence_requirement": "independent_response_without_revealing_prompt"},
        {"objective_id": "PRE_A1-O016", "mode": "interaction", "can_do_zh": "在一个未排练的简单场景中完成问候、回应、求助和结束。", "target_knowledge_ids": ["PRE_A1-K032", "PRE_A1-K002", "PRE_A1-K005", "PRE_A1-K024"], "evidence_requirement": "independent_unrehearsed_role_play"},
