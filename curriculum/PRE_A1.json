{
  "schema_version": "1.0",
  "curriculum_id": "gpt-live-english-foundations",
  "curriculum_version": "1.0.0",
  "level_id": "PRE_A1",
  "level_order": 0,
  "title_zh": "Pre-A1 零起点生存英语",
  "entry_standard_zh": "不要求已有英语知识；可以用中文回答需求与困难。",
  "exit_standard_zh": "能在熟悉且高度可预测的场景中听懂极短指令，并用已学短句完成基本互动。",
  "support_policy": {
    "chinese_support": "default_on",
    "english_input_percent_start": 20,
    "english_input_percent_end": 45,
    "teacher_turn_max_words": 10,
    "new_knowledge_per_lesson_max": 5
  },
  "lesson_flow": [
    "course_goal",
    "demonstration",
    "repeat_after_model",
    "guided_practice",
    "independent_expression",
    "check",
    "review"
  ],
  "units": [
    {
      "unit_id": "PRE_A1-U01",
      "order": 1,
      "title_zh": "听懂课堂并求助",
      "title_en": "Classroom Survival",
      "prerequisite_units": [],
      "prerequisite_knowledge_ids": [],
      "knowledge": [
        {"knowledge_id": "PRE_A1-K001", "type": "chunk", "form": "Yes. / No.", "meaning_zh": "是／不是"},
        {"knowledge_id": "PRE_A1-K002", "type": "chunk", "form": "I don't understand.", "meaning_zh": "我不明白"},
        {"knowledge_id": "PRE_A1-K003", "type": "chunk", "form": "Please say it again.", "meaning_zh": "请再说一遍"},
        {"knowledge_id": "PRE_A1-K004", "type": "listening", "form": "listen / say / choose / again", "meaning_zh": "四个课堂指令词"}
      ],
      "objectives": [
        {"objective_id": "PRE_A1-O001", "mode": "listening", "can_do_zh": "在无文字答案时听懂一个已学的单步指令，并用动作或 yes/no 作出回应。", "target_knowledge_ids": ["PRE_A1-K001", "PRE_A1-K004"], "evidence_requirement": "unseen_audio_choice_without_text"},
        {"objective_id": "PRE_A1-O002", "mode": "interaction", "can_do_zh": "听不懂时主动说出一个求助短句。", "target_knowledge_ids": ["PRE_A1-K002", "PRE_A1-K003"], "evidence_requirement": "independent_response_without_revealing_prompt"}
      ],
      "teaching_notes_zh": ["先用中文说明每个课堂动作。", "一次只说一个英文指令，等待反应。", "学习者可随时用中文求助。"],
      "completion_criteria": {
        "required_objective_ids": ["PRE_A1-O001", "PRE_A1-O002"],
        "minimum_independent_passes_per_objective": 1,
        "mastery_requires_distinct_sessions": 2,
        "requires_unseen_listening_check": true,
        "repeat_after_model_counts_as_independent": false,
        "transcript_only_pronunciation_scoring_allowed": false
      }
    },
    {
      "unit_id": "PRE_A1-U02",
      "order": 2,
      "title_zh": "打招呼和姓名",
      "title_en": "Hello and Names",
      "prerequisite_units": ["PRE_A1-U01"],
      "prerequisite_knowledge_ids": ["PRE_A1-K002", "PRE_A1-K003"],
      "knowledge": [
        {"knowledge_id": "PRE_A1-K005", "type": "chunk", "form": "Hello. / Hi. / Goodbye.", "meaning_zh": "你好／再见"},
        {"knowledge_id": "PRE_A1-K006", "type": "chunk", "form": "My name is ___.", "meaning_zh": "我叫……"},
        {"knowledge_id": "PRE_A1-K007", "type": "chunk", "form": "What's your name?", "meaning_zh": "你叫什么名字？"},
        {"knowledge_id": "PRE_A1-K008", "type": "grammar", "form": "I / you + am / are", "meaning_zh": "最基础的人称与 be 动词"}
      ],
      "objectives": [
        {"objective_id": "PRE_A1-O003", "mode": "interaction", "can_do_zh": "独立完成问候、用 I am / you are 说出或确认姓名并告别。", "target_knowledge_ids": ["PRE_A1-K005", "PRE_A1-K006", "PRE_A1-K008"], "evidence_requirement": "independent_role_play_without_sentence_starter"},
        {"objective_id": "PRE_A1-O004", "mode": "listening", "can_do_zh": "从两个陌生姓名中听辨对方说出的姓名。", "target_knowledge_ids": ["PRE_A1-K007"], "evidence_requirement": "unseen_audio_choice_without_text"}
      ],
      "teaching_notes_zh": ["中文先说明问答轮次。", "姓名可使用学习者真实姓名。", "跟读后必须换角色重新开始，才进入独立表达。"],
      "completion_criteria": {
        "required_objective_ids": ["PRE_A1-O003", "PRE_A1-O004"],
        "minimum_independent_passes_per_objective": 1,
        "mastery_requires_distinct_sessions": 2,
        "requires_unseen_listening_check": true,
        "repeat_after_model_counts_as_independent": false,
        "transcript_only_pronunciation_scoring_allowed": false
      }
    },
    {
      "unit_id": "PRE_A1-U03",
      "order": 3,
      "title_zh": "字母和拼写姓名",
      "title_en": "Letters and Spelling",
      "prerequisite_units": ["PRE_A1-U02"],
      "prerequisite_knowledge_ids": ["PRE_A1-K006", "PRE_A1-K007"],
      "knowledge": [
        {"knowledge_id": "PRE_A1-K009", "type": "vocabulary", "form": "A-Z letter names", "meaning_zh": "英文字母名称"},
        {"knowledge_id": "PRE_A1-K010", "type": "chunk", "form": "How do you spell it?", "meaning_zh": "怎么拼写？"},
        {"knowledge_id": "PRE_A1-K011", "type": "chunk", "form": "It's ___.", "meaning_zh": "它是……"},
        {"knowledge_id": "PRE_A1-K012", "type": "pronunciation", "form": "confusable letter names", "meaning_zh": "易混字母名称的可懂度"}
      ],
      "objectives": [
        {"objective_id": "PRE_A1-O005", "mode": "interaction", "can_do_zh": "独立询问拼写，并在不看示范时拼出自己的姓名或一个已学单词。", "target_knowledge_ids": ["PRE_A1-K009", "PRE_A1-K010", "PRE_A1-K011"], "evidence_requirement": "independent_response_without_revealing_prompt"},
        {"objective_id": "PRE_A1-O006", "mode": "listening", "can_do_zh": "听辨三组与本人相关的字母序列。", "target_knowledge_ids": ["PRE_A1-K009", "PRE_A1-K012"], "evidence_requirement": "unseen_audio_choice_without_text"}
      ],
      "teaching_notes_zh": ["只选学习者姓名所需字母和少量易混字母。", "语音观察只记录是否可懂及混淆现象，不给精确音素分数。"],
      "completion_criteria": {
        "required_objective_ids": ["PRE_A1-O005", "PRE_A1-O006"],
        "minimum_independent_passes_per_objective": 1,
        "mastery_requires_distinct_sessions": 2,
        "requires_unseen_listening_check": true,
        "repeat_after_model_counts_as_independent": false,
        "transcript_only_pronunciation_scoring_allowed": false
      }
    },
    {
      "unit_id": "PRE_A1-U04",
      "order": 4,
      "title_zh": "数字和个人信息",
      "title_en": "Numbers and Personal Details",
      "prerequisite_units": ["PRE_A1-U03"],
      "prerequisite_knowledge_ids": ["PRE_A1-K009", "PRE_A1-K011"],
      "knowledge": [
        {"knowledge_id": "PRE_A1-K013", "type": "vocabulary", "form": "numbers 0-20", "meaning_zh": "数字 0–20"},
        {"knowledge_id": "PRE_A1-K014", "type": "chunk", "form": "I'm ___ years old.", "meaning_zh": "我……岁"},
        {"knowledge_id": "PRE_A1-K015", "type": "chunk", "form": "My number is ___.", "meaning_zh": "我的号码是……"},
        {"knowledge_id": "PRE_A1-K016", "type": "listening", "form": "number strings", "meaning_zh": "连续数字听辨"}
      ],
      "objectives": [
        {"objective_id": "PRE_A1-O007", "mode": "speaking", "can_do_zh": "独立说出年龄或一串与自己有关的数字。", "target_knowledge_ids": ["PRE_A1-K013", "PRE_A1-K014", "PRE_A1-K015"], "evidence_requirement": "independent_response_without_revealing_prompt"},
        {"objective_id": "PRE_A1-O008", "mode": "listening", "can_do_zh": "听辨四个未按教学顺序出现的数字。", "target_knowledge_ids": ["PRE_A1-K013", "PRE_A1-K016"], "evidence_requirement": "unseen_audio_choice_without_text"}
      ],
      "teaching_notes_zh": ["先练 0–10，再按需要扩展到 20。", "不得要求提供真实电话号码，可使用虚构号码。"],
      "completion_criteria": {
        "required_objective_ids": ["PRE_A1-O007", "PRE_A1-O008"],
        "minimum_independent_passes_per_objective": 1,
        "mastery_requires_distinct_sessions": 2,
        "requires_unseen_listening_check": true,
        "repeat_after_model_counts_as_independent": false,
        "transcript_only_pronunciation_scoring_allowed": false
      }
    },
    {
      "unit_id": "PRE_A1-U05",
