      "title_zh": "身边的人和物",
      "title_en": "People and Things",
      "prerequisite_units": ["PRE_A1-U04"],
      "prerequisite_knowledge_ids": ["PRE_A1-K008", "PRE_A1-K013"],
      "knowledge": [
        {"knowledge_id": "PRE_A1-K017", "type": "grammar", "form": "This is ___. / That's ___.", "meaning_zh": "介绍近处／远处的人或物"},
        {"knowledge_id": "PRE_A1-K018", "type": "vocabulary", "form": "person / book / phone / bag / cup", "meaning_zh": "常见人和物"},
        {"knowledge_id": "PRE_A1-K019", "type": "vocabulary", "form": "red / blue / black / white", "meaning_zh": "基础颜色"},
        {"knowledge_id": "PRE_A1-K020", "type": "chunk", "form": "What is this?", "meaning_zh": "这是什么？"}
      ],
      "objectives": [
        {"objective_id": "PRE_A1-O009", "mode": "interaction", "can_do_zh": "独立询问并指认两个身边物品，可加一个颜色。", "target_knowledge_ids": ["PRE_A1-K017", "PRE_A1-K018", "PRE_A1-K019", "PRE_A1-K020"], "evidence_requirement": "independent_response_to_new_object"},
        {"objective_id": "PRE_A1-O010", "mode": "listening", "can_do_zh": "听懂对两个物品的简短指认。", "target_knowledge_ids": ["PRE_A1-K017", "PRE_A1-K018"], "evidence_requirement": "unseen_audio_choice_without_text"}
      ],
      "teaching_notes_zh": ["优先使用学习者看得到的实物。", "不引入复数规则或复杂描述。"],
      "completion_criteria": {
        "required_objective_ids": ["PRE_A1-O009", "PRE_A1-O010"],
        "minimum_independent_passes_per_objective": 1,
        "mastery_requires_distinct_sessions": 2,
        "requires_unseen_listening_check": true,
        "repeat_after_model_counts_as_independent": false,
        "transcript_only_pronunciation_scoring_allowed": false
      }
    },
    {
      "unit_id": "PRE_A1-U06",
      "order": 6,
      "title_zh": "喜欢、想要与礼貌请求",
      "title_en": "Likes, Wants, and Please",
      "prerequisite_units": ["PRE_A1-U05"],
      "prerequisite_knowledge_ids": ["PRE_A1-K001", "PRE_A1-K018"],
      "knowledge": [
        {"knowledge_id": "PRE_A1-K021", "type": "chunk", "form": "I like ___. / I don't like ___.", "meaning_zh": "我喜欢／不喜欢……"},
        {"knowledge_id": "PRE_A1-K022", "type": "chunk", "form": "I want ___, please.", "meaning_zh": "我想要……，谢谢"},
        {"knowledge_id": "PRE_A1-K023", "type": "vocabulary", "form": "water / tea / coffee / rice / bread", "meaning_zh": "基础饮食词"},
        {"knowledge_id": "PRE_A1-K024", "type": "pragmatics", "form": "please / thank you", "meaning_zh": "基础礼貌表达"}
      ],
      "objectives": [
        {"objective_id": "PRE_A1-O011", "mode": "interaction", "can_do_zh": "在新的二选一情境中独立表达喜欢或不喜欢。", "target_knowledge_ids": ["PRE_A1-K021", "PRE_A1-K023"], "evidence_requirement": "independent_choice_without_sentence_starter"},
        {"objective_id": "PRE_A1-O012", "mode": "interaction", "can_do_zh": "在简单点单中独立提出一个礼貌请求。", "target_knowledge_ids": ["PRE_A1-K022", "PRE_A1-K024"], "evidence_requirement": "independent_role_play_without_sentence_starter"}
      ],
      "teaching_notes_zh": ["先给图片或中文选项，再移除句型提示。", "只要求一个请求，不追加数量和价格。"],
      "completion_criteria": {
        "required_objective_ids": ["PRE_A1-O011", "PRE_A1-O012"],
        "minimum_independent_passes_per_objective": 1,
        "mastery_requires_distinct_sessions": 2,
        "requires_unseen_listening_check": false,
        "repeat_after_model_counts_as_independent": false,
        "transcript_only_pronunciation_scoring_allowed": false
      }
    },
