      "title_zh": "位置和寻找物品",
      "title_en": "Where Is It?",
      "prerequisite_units": ["PRE_A1-U06"],
      "prerequisite_knowledge_ids": ["PRE_A1-K017", "PRE_A1-K018", "PRE_A1-K020"],
      "knowledge": [
        {"knowledge_id": "PRE_A1-K025", "type": "chunk", "form": "Where is the ___?", "meaning_zh": "……在哪里？"},
        {"knowledge_id": "PRE_A1-K026", "type": "chunk", "form": "It's here. / It's there.", "meaning_zh": "在这里／那里"},
        {"knowledge_id": "PRE_A1-K027", "type": "grammar", "form": "in / on", "meaning_zh": "在……里面／上面"},
        {"knowledge_id": "PRE_A1-K028", "type": "listening", "form": "short location instructions", "meaning_zh": "极短位置说明"}
      ],
      "objectives": [
        {"objective_id": "PRE_A1-O013", "mode": "interaction", "can_do_zh": "独立询问一个物品的位置并理解短答。", "target_knowledge_ids": ["PRE_A1-K025", "PRE_A1-K026"], "evidence_requirement": "independent_role_play_without_sentence_starter"},
        {"objective_id": "PRE_A1-O014", "mode": "listening", "can_do_zh": "听懂物品在里面或上面的区别。", "target_knowledge_ids": ["PRE_A1-K027", "PRE_A1-K028"], "evidence_requirement": "unseen_audio_choice_without_text"}
      ],
      "teaching_notes_zh": ["用两个真实或想象中的位置形成最小对比。", "暂不引入完整地点介词系统。"],
