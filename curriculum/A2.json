{
  "schema_version": "1.0",
  "curriculum_id": "gpt-live-english-foundations",
  "curriculum_version": "1.1.0",
  "level_id": "A2",
  "level_order": 2,
  "title_zh": "A2 日常沟通英语",
  "entry_standard_zh": "已达到 A1 完成标准，或经独立听说检验证明具备同等能力。",
  "exit_standard_zh": "能在常见生活与服务场景中交换信息、讲述短经历，并用简单连接词表达理由。",
  "support_policy": {
    "chinese_support": "brief_on_request",
    "english_input_percent_start": 70,
    "english_input_percent_end": 85,
    "teacher_turn_max_words": 35,
    "new_knowledge_per_lesson_max": 7
  },
  "lesson_flow": ["course_goal", "demonstration", "repeat_after_model", "guided_practice", "independent_expression", "check", "review"],
  "units": [
    {
      "unit_id": "A2-U01", "order": 1, "title_zh": "连接过去的故事", "title_en": "Connected Past Stories",
      "prerequisite_units": ["A1-U08"],
      "prerequisite_knowledge_ids": ["A1-K025", "A1-K026", "A1-K028"],
      "knowledge": [
        {"knowledge_id": "A2-K001", "type": "grammar", "form": "past simple sequence", "meaning_zh": "连续叙述过去事件"},
        {"knowledge_id": "A2-K002", "type": "chunk", "form": "first / then / after that / finally", "meaning_zh": "基础叙事连接词"},
        {"knowledge_id": "A2-K003", "type": "interaction", "form": "What happened next?", "meaning_zh": "推动叙事的追问"},
        {"knowledge_id": "A2-K004", "type": "listening", "form": "event order and key detail", "meaning_zh": "事件顺序与细节听辨"}
      ],
      "objectives": [
        {"objective_id": "A2-O001", "mode": "speaking", "can_do_zh": "不用提纲，按顺序讲述四至六句的短经历。", "target_knowledge_ids": ["A2-K001", "A2-K002"], "evidence_requirement": "independent_short_narrative_without_language_prompts"},
        {"objective_id": "A2-O002", "mode": "listening", "can_do_zh": "听一段新短故事并复原三项事件顺序。", "target_knowledge_ids": ["A2-K003", "A2-K004"], "evidence_requirement": "unseen_audio_questions_without_text"}
      ],
      "teaching_notes_zh": ["先以四格事件示范，再换事件做独立表达。", "纠错优先保证时间与顺序清楚。"],
      "completion_criteria": {"required_objective_ids": ["A2-O001", "A2-O002"], "minimum_independent_passes_per_objective": 1, "mastery_requires_distinct_sessions": 2, "requires_unseen_listening_check": true, "repeat_after_model_counts_as_independent": false, "transcript_only_pronunciation_scoring_allowed": false}
    },
    {
      "unit_id": "A2-U02", "order": 2, "title_zh": "比较和选择", "title_en": "Comparing and Choosing",
      "prerequisite_units": ["A2-U01"],
      "prerequisite_knowledge_ids": ["A1-K011", "A1-K014", "A2-K002"],
      "knowledge": [
        {"knowledge_id": "A2-K005", "type": "grammar", "form": "comparative adjectives", "meaning_zh": "形容词比较级"},
        {"knowledge_id": "A2-K006", "type": "grammar", "form": "the most / the best", "meaning_zh": "高频最高级"},
        {"knowledge_id": "A2-K007", "type": "chunk", "form": "I prefer ___ because ___.", "meaning_zh": "表达选择与简单理由"},
        {"knowledge_id": "A2-K008", "type": "listening", "form": "comparison details", "meaning_zh": "比较信息听辨"}
      ],
      "objectives": [
        {"objective_id": "A2-O003", "mode": "speaking", "can_do_zh": "比较两个新选项并给出一个理由。", "target_knowledge_ids": ["A2-K005", "A2-K007"], "evidence_requirement": "independent_choice_with_reason"},
        {"objective_id": "A2-O004", "mode": "listening", "can_do_zh": "听懂一段比较，判断说话者最终选择及理由。", "target_knowledge_ids": ["A2-K006", "A2-K008"], "evidence_requirement": "unseen_audio_questions_without_text"}
      ],
      "teaching_notes_zh": ["先选规则变化小的常用形容词。", "理由限定为一个已学连接词 because。"],
      "completion_criteria": {"required_objective_ids": ["A2-O003", "A2-O004"], "minimum_independent_passes_per_objective": 1, "mastery_requires_distinct_sessions": 2, "requires_unseen_listening_check": true, "repeat_after_model_counts_as_independent": false, "transcript_only_pronunciation_scoring_allowed": false}
    },
    {
      "unit_id": "A2-U03", "order": 3, "title_zh": "经历和最近发生的事", "title_en": "Experiences and Recent Events",
      "prerequisite_units": ["A2-U02"],
      "prerequisite_knowledge_ids": ["A1-K025", "A2-K001", "A2-K003"],
      "knowledge": [
        {"knowledge_id": "A2-K009", "type": "grammar", "form": "Have you ever + past participle?", "meaning_zh": "询问人生经历"},
        {"knowledge_id": "A2-K010", "type": "grammar", "form": "present perfect vs finished past time", "meaning_zh": "经历与具体过去时间的区别"},
        {"knowledge_id": "A2-K011", "type": "chunk", "form": "Yes, I have. It was ___.", "meaning_zh": "回答并补充经历"},
        {"knowledge_id": "A2-K012", "type": "vocabulary", "form": "ever / never / already / yet", "meaning_zh": "经历相关副词"}
      ],
      "objectives": [
        {"objective_id": "A2-O005", "mode": "interaction", "can_do_zh": "询问一项经历并用过去时追问一个细节。", "target_knowledge_ids": ["A2-K009", "A2-K010", "A2-K011"], "evidence_requirement": "unrehearsed_question_answer_exchange"},
        {"objective_id": "A2-O006", "mode": "speaking", "can_do_zh": "独立说出做过或没做过的两件事，并展开其中一件。", "target_knowledge_ids": ["A2-K010", "A2-K012"], "evidence_requirement": "independent_short_turn_without_sentence_starter"}
      ],
      "teaching_notes_zh": ["只选高频过去分词，避免动词表灌输。", "先建立经历与具体时间的意义差别。"],
      "completion_criteria": {"required_objective_ids": ["A2-O005", "A2-O006"], "minimum_independent_passes_per_objective": 1, "mastery_requires_distinct_sessions": 2, "requires_unseen_listening_check": false, "repeat_after_model_counts_as_independent": false, "transcript_only_pronunciation_scoring_allowed": false}
    },
    {
      "unit_id": "A2-U04", "order": 4, "title_zh": "建议、规则与健康", "title_en": "Advice, Rules, and Health",
      "prerequisite_units": ["A2-U03"],
      "prerequisite_knowledge_ids": ["A1-K017", "A1-K018", "A2-K007"],
      "knowledge": [
        {"knowledge_id": "A2-K013", "type": "grammar", "form": "should / shouldn't", "meaning_zh": "给建议"},
        {"knowledge_id": "A2-K014", "type": "grammar", "form": "have to / don't have to", "meaning_zh": "义务与非必要"},
        {"knowledge_id": "A2-K015", "type": "vocabulary", "form": "headache / tired / rest / appointment / medicine", "meaning_zh": "基础健康词汇"},
        {"knowledge_id": "A2-K016", "type": "pragmatics", "form": "Maybe you should ___.", "meaning_zh": "较柔和地给建议"}
      ],
      "objectives": [
        {"objective_id": "A2-O007", "mode": "interaction", "can_do_zh": "听懂一个常见问题并给出两条合适建议。", "target_knowledge_ids": ["A2-K013", "A2-K015", "A2-K016"], "evidence_requirement": "independent_response_to_unseen_problem"},
        {"objective_id": "A2-O008", "mode": "speaking", "can_do_zh": "说明一条真实规则以及一件不必做的事。", "target_knowledge_ids": ["A2-K014"], "evidence_requirement": "independent_short_turn_without_sentence_starter"}
      ],
      "teaching_notes_zh": ["健康场景只练语言，不提供医疗诊断。", "明确 should 与 have to 的力度差别。"],
      "completion_criteria": {"required_objective_ids": ["A2-O007", "A2-O008"], "minimum_independent_passes_per_objective": 1, "mastery_requires_distinct_sessions": 2, "requires_unseen_listening_check": false, "repeat_after_model_counts_as_independent": false, "transcript_only_pronunciation_scoring_allowed": false}
    },
    {
      "unit_id": "A2-U05", "order": 5, "title_zh": "服务问题与解决", "title_en": "Service Problems and Solutions",
      "prerequisite_units": ["A2-U04"],
      "prerequisite_knowledge_ids": ["A1-K015", "A1-K018", "A2-K016"],
      "knowledge": [
        {"knowledge_id": "A2-K017", "type": "chunk", "form": "There's a problem with ___.", "meaning_zh": "说明服务问题"},
        {"knowledge_id": "A2-K018", "type": "chunk", "form": "Could you ___, please?", "meaning_zh": "提出较礼貌的解决请求"},
        {"knowledge_id": "A2-K019", "type": "chunk", "form": "I'm sorry, but ___.", "meaning_zh": "礼貌提出异议"},
        {"knowledge_id": "A2-K020", "type": "listening", "form": "problem / requested solution / outcome", "meaning_zh": "问题、诉求与结果听辨"}
      ],
      "objectives": [
        {"objective_id": "A2-O009", "mode": "interaction", "can_do_zh": "在酒店、餐厅或商店的新问题中说明情况并请求解决。", "target_knowledge_ids": ["A2-K017", "A2-K018", "A2-K019"], "evidence_requirement": "independent_unrehearsed_role_play"},
        {"objective_id": "A2-O010", "mode": "listening", "can_do_zh": "听懂服务人员给出的解决办法并确认关键信息。", "target_knowledge_ids": ["A2-K020"], "evidence_requirement": "unseen_audio_questions_without_text"}
      ],
      "teaching_notes_zh": ["每次只处理一个问题和一个诉求。", "纠错优先语用清晰度，不追求复杂投诉语言。"],
      "completion_criteria": {"required_objective_ids": ["A2-O009", "A2-O010"], "minimum_independent_passes_per_objective": 1, "mastery_requires_distinct_sessions": 2, "requires_unseen_listening_check": true, "repeat_after_model_counts_as_independent": false, "transcript_only_pronunciation_scoring_allowed": false}
    },
    {
      "unit_id": "A2-U06", "order": 6, "title_zh": "邀请、安排与改变计划", "title_en": "Invitations and Arrangements",
      "prerequisite_units": ["A2-U05"],
      "prerequisite_knowledge_ids": ["A1-K029", "A1-K030", "A2-K018"],
      "knowledge": [
        {"knowledge_id": "A2-K021", "type": "chunk", "form": "Would you like to ___?", "meaning_zh": "发出邀请"},
        {"knowledge_id": "A2-K022", "type": "chunk", "form": "I'd love to, but ___.", "meaning_zh": "礼貌拒绝并说明原因"},
        {"knowledge_id": "A2-K023", "type": "chunk", "form": "How about ___ instead?", "meaning_zh": "提出替代安排"},
        {"knowledge_id": "A2-K024", "type": "pragmatics", "form": "accept / decline / counter-offer", "meaning_zh": "邀请回应的三种动作"}
      ],
      "objectives": [
        {"objective_id": "A2-O011", "mode": "interaction", "can_do_zh": "发出邀请并协商时间或替代活动。", "target_knowledge_ids": ["A2-K021", "A2-K023", "A2-K024"], "evidence_requirement": "independent_unrehearsed_role_play"},
        {"objective_id": "A2-O012", "mode": "interaction", "can_do_zh": "自然接受或礼貌拒绝一个新邀请。", "target_knowledge_ids": ["A2-K022", "A2-K024"], "evidence_requirement": "independent_response_to_unseen_invitation"}
      ],
      "teaching_notes_zh": ["先明确交际动作，再练语言。", "不要求复杂条件句。"],
      "completion_criteria": {"required_objective_ids": ["A2-O011", "A2-O012"], "minimum_independent_passes_per_objective": 1, "mastery_requires_distinct_sessions": 2, "requires_unseen_listening_check": false, "repeat_after_model_counts_as_independent": false, "transcript_only_pronunciation_scoring_allowed": false}
    },
    {
      "unit_id": "A2-U07", "order": 7, "title_zh": "观点和简单理由", "title_en": "Opinions and Reasons",
      "prerequisite_units": ["A2-U06"],
      "prerequisite_knowledge_ids": ["A2-K007", "A2-K016", "A2-K024"],
      "knowledge": [
        {"knowledge_id": "A2-K025", "type": "chunk", "form": "I think ___ because ___.", "meaning_zh": "表达观点与理由"},
        {"knowledge_id": "A2-K026", "type": "chunk", "form": "I agree. / I'm not sure.", "meaning_zh": "同意或保留意见"},
        {"knowledge_id": "A2-K027", "type": "grammar", "form": "because / so / but", "meaning_zh": "基础逻辑连接"},
        {"knowledge_id": "A2-K028", "type": "listening", "form": "speaker opinion and reason", "meaning_zh": "观点与理由听辨"}
      ],
      "objectives": [
        {"objective_id": "A2-O013", "mode": "speaking", "can_do_zh": "就熟悉问题独立表达观点并给出两个简单理由。", "target_knowledge_ids": ["A2-K025", "A2-K027"], "evidence_requirement": "independent_opinion_without_language_prompts"},
        {"objective_id": "A2-O014", "mode": "listening", "can_do_zh": "听懂说话者的立场和一个理由，并作简短回应。", "target_knowledge_ids": ["A2-K026", "A2-K028"], "evidence_requirement": "unseen_audio_questions_without_text"}
      ],
      "teaching_notes_zh": ["话题必须熟悉具体，不进入抽象辩论。", "先回应内容，再纠正语言。"],
      "completion_criteria": {"required_objective_ids": ["A2-O013", "A2-O014"], "minimum_independent_passes_per_objective": 1, "mastery_requires_distinct_sessions": 2, "requires_unseen_listening_check": true, "repeat_after_model_counts_as_independent": false, "transcript_only_pronunciation_scoring_allowed": false}
    },
    {
      "unit_id": "A2-U08", "order": 8, "title_zh": "旅行安排与 A2 综合检验", "title_en": "Travel Plan and A2 Check",
      "prerequisite_units": ["A2-U07"],
      "prerequisite_knowledge_ids": ["A2-K005", "A2-K017", "A2-K021", "A2-K025"],
      "knowledge": [
        {"knowledge_id": "A2-K029", "type": "interaction", "form": "ask → compare → choose → solve", "meaning_zh": "多步日常任务结构"},
        {"knowledge_id": "A2-K030", "type": "vocabulary", "form": "ticket / booking / available / change / return", "meaning_zh": "旅行安排高频词"},
        {"knowledge_id": "A2-K031", "type": "chunk", "form": "Could I change ___?", "meaning_zh": "请求变更安排"},
        {"knowledge_id": "A2-K032", "type": "listening", "form": "multi-turn practical details", "meaning_zh": "多轮实用信息听辨"}
      ],
      "objectives": [
        {"objective_id": "A2-O015", "mode": "interaction", "can_do_zh": "在未排练的旅行任务中询问信息、比较选项并处理一个变化。", "target_knowledge_ids": ["A2-K029", "A2-K030", "A2-K031"], "evidence_requirement": "independent_integrated_level_check"},
        {"objective_id": "A2-O016", "mode": "listening", "can_do_zh": "从多轮短对话中提取时间、选择和变化三类信息。", "target_knowledge_ids": ["A2-K032"], "evidence_requirement": "unseen_audio_questions_without_text"}
      ],
      "teaching_notes_zh": ["综合任务只调用 A2 及此前语言。", "检验前不排演相同旅行脚本。"],
      "completion_criteria": {"required_objective_ids": ["A2-O015", "A2-O016"], "minimum_independent_passes_per_objective": 1, "mastery_requires_distinct_sessions": 2, "requires_unseen_listening_check": true, "repeat_after_model_counts_as_independent": false, "transcript_only_pronunciation_scoring_allowed": false}
    }
  ]
}
